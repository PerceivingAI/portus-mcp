PORTUS_MCP_HOST=127.0.0.1
PORTUS_MCP_PORT=8789
# MCP route path. Defaults to /mcp. For no-auth public tunnels (e.g. Tailscale Funnel), use a secret path like /secret-key-1234/mcp
PORTUS_MCP_PATH=/mcp
# Optional. Use only with MCP clients that support static bearer tokens, such as Codex Desktop.
# Leave empty for ChatGPT's current custom MCP connector flow.
PORTUS_MCP_BEARER_TOKEN=
# Optional orchestrator variables for "npm run start:tunnel"
# PORTUS_TUNNEL_CLIENT_PATH=C:\tools\tunnel-client\tunnel-client.exe
# PORTUS_TUNNEL_PROFILE=portus-local
PORTUS_MCP_FLUE_CLI_PATH=./node_modules/@flue/cli/dist/flue.js
# Application, policy, and state locations.
PORTUS_MCP_CONFIG_PATH=./portus-mcp.config.json
# To select a private operator policy, copy the complete shipped policy to portus-mcp.policy.local.json and set that path here. Policies are never merged.
PORTUS_MCP_POLICY_PATH=./portus-mcp.policy.json
PORTUS_MCP_STATE_DIR=.portus-mcp
# Pre-registered projects (one line per project inside quotes, or separated by newlines/pipes/semicolons):
# On Linux:
# PORTUS_MCP_PROJECTS="
#   app_1=/home/user/projects/app_1
#   app_2=/home/user/projects/app_2
# "
# On Windows:
# PORTUS_MCP_PROJECTS="
#   app_1=C:\path\to\app_1
#   app_2=C:\path\to\app_2
# "
PORTUS_MCP_PROJECTS=
# Semicolon-separated skill directories or catalogs. Unset defaults to ./skills; explicitly empty disables that audience.
AGENT_SKILL_PATHS=./skills
SUBAGENTS_SKILL_PATHS=./skills

PORTUS_MCP_DEFAULT_PROVIDER=cloudflare
PORTUS_MCP_OPENAI_MODEL=gpt-5.4-mini
PORTUS_MCP_CEREBRAS_MODEL=llama3.1-8b
PORTUS_MCP_GEMINI_MODEL=gemini-3.5-flash-lite
PORTUS_MCP_CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it
PORTUS_MCP_OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional. Can be left empty if you don't plan to use spawned agents.
# You only need to include the keys to the providers you want to use.
OPENAI_API_KEY=openai_api_key
CEREBRAS_API_KEY=cerebras_api_key
GEMINI_API_KEY=gemini_api_key
CLOUDFLARE_API_KEY=cloudflare_api_key
CLOUDFLARE_ACCOUNT_ID=cloudflare_account_id
OPENROUTER_API_KEY=openrouter_api_key
