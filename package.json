{
  "name": "portus-mcp",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local-first, multi-machine MCP server for AI-assisted project work.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "setup:tunnel": "node scripts/setup-tunnel.mjs",
    "start:tunnel": "node scripts/start-all.mjs --tunnel",
    "start:funnel": "node scripts/start-all.mjs --funnel",
    "start:serve": "node scripts/start-all.mjs --serve",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "build": "tsc",
    "flue:check": "node scripts/check-flue.mjs",
    "clean-state": "node scripts/clean-state.mjs",
    "tailscale:status": "node scripts/check-tailscale.mjs"
  },
  "dependencies": {
    "@flue/cli": "^0.2.0",
    "@flue/sdk": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "dotenv": "^16.4.7",
    "just-bash": "^2.14.5",
    "node-screenshots": "0.2.8",
    "sharp": "0.35.3",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
